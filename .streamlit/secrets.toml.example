# Local run: copy this file to .streamlit/secrets.toml
# Streamlit Community Cloud: paste the same content in App settings -> Secrets
# Never commit the real secrets.toml (it is in .gitignore).

# Supabase -> Connect (top of the project page) -> "Session pooler" string, copied exactly,
# with [YOUR-PASSWORD] replaced by your database password (host may be aws-0-... or aws-1-...)
DATABASE_URL = "postgresql://postgres.xxxxxxxx:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Cloudflare R2 (bucket + API token with Object Read & Write)
R2_ACCOUNT_ID = ""
R2_ACCESS_KEY_ID = ""
R2_SECRET_ACCESS_KEY = ""
R2_BUCKET = "bambara-audio"

# Password for the Admin page (sentence pairs)
ADMIN_PASSWORD = "choose-a-long-password"
